rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All application access goes through the Flask backend using the
    // Firebase Admin SDK, which bypasses these rules entirely.
    // No client ever connects to Firestore directly, so direct client
    // access is denied outright.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
